<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always renders a system splash before Flutter's first
         frame; by default it centers the launcher icon. Use a transparent
         icon + the animation's exact navy so the user sees only a plain
         navy flash that flows straight into the particle splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#16324F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
