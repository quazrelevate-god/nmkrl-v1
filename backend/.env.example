# ─────────────────────────────────────────────────────────────────────────────
# Nam Kural Connect — backend configuration
#
# Copy this file to `.env` and fill in the values for your environment. Every
# variable the backend reads is listed here; anything left blank falls back to
# the documented default. `.env` is git-ignored — never commit real secrets.
#
# For a production hand-over, the values that MUST be set are marked [REQUIRED].
# The rest have safe defaults for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
# Powers voice-note transcription + translation, department routing, duplicate
# detection, and the attached-document summary. Either variable works; if BOTH
# are blank the backend returns a clearly-labelled MOCK transcript so the app
# still works end-to-end, but no real AI runs.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Admin console sign-in ────────────────────────────────────────────────────
# The single shared operator account that guards every /api/admin/* route and
# the web console. CHANGE THE PASSWORD before the service is reachable from
# outside a demo laptop — the default below is public in the source.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nammakural                 # [REQUIRED in production] — override this
# Signing key for admin tokens. If unset, a random key is generated per boot,
# which simply means a restart signs admins out. Set a fixed value to keep
# admin sessions alive across restarts.
ADMIN_SECRET=
ADMIN_TOKEN_HOURS=12                       # admin token lifetime

# ── Citizen + coordinator sessions ───────────────────────────────────────────
# Signing key for the long-lived citizen/coordinator session tokens. If unset,
# a key is generated once and stored in the database (on the persistent volume),
# so sessions survive redeploys. Set SESSION_SECRET to rotate or share the key
# across instances.
SESSION_SECRET=
CITIZEN_SESSION_DAYS=180                    # citizen token lifetime
COORDINATOR_SESSION_DAYS=30                 # coordinator token lifetime

# ── SMS OTP gateway (APM Technologies) ───────────────────────────────────────
# Sends the login OTP by SMS. [REQUIRED in production] — without it, and with
# ALLOW_DEV_OTP off, phone sign-in is unavailable and the app cannot log anyone
# in.
APM_SMS_API_KEY=

# Development only: when set to 1/true/yes, the server generates the OTP itself
# and returns it in the response as `dev_otp` instead of sending an SMS. NEVER
# enable this in production — it lets anyone sign in as any number.
ALLOW_DEV_OTP=

# App-store reviewer login: one fixed number + code that bypasses the SMS
# gateway (reviewers cannot receive an Indian SMS). Leave blank in production
# unless an app review is in progress.
REVIEW_LOGIN_PHONE=
REVIEW_LOGIN_OTP=

# ── Push notifications (Firebase Cloud Messaging, HTTP v1) ───────────────────
# Both are needed for real device push. FCM_SERVICE_ACCOUNT_JSON is the full
# service-account JSON (as a single-line string or a path the app reads). With
# either blank, notifications are still queued in-app (polled by the clients)
# but no device push is sent.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── Persistence paths ────────────────────────────────────────────────────────
# Where the SQLite DB and uploaded media live. Both auto-detect a mounted
# /data volume (Railway) when unset, and fall back to a local folder in
# development. Set them explicitly only to override that resolution.
DB_PATH=
UPLOAD_DIR=

# ── Demo data reset (use deliberately) ───────────────────────────────────────
# When set to 1/true/yes, the next boot RESETS the database to the bundled demo
# seed — destroying live data. The persistent volume is meant to keep data
# across redeploys, so this only exists to reset a clean demo dataset before a
# pitch: set it, redeploy, then UNSET it. Leave blank in normal operation.
FORCE_RESEED=
